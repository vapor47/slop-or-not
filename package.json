{
  "name": "slop-or-not",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && node --check public/app.js",
    "password": "node scripts/password.mjs",
    "sample": "node --env-file-if-exists=.env scripts/sample.ts",
    "storage:check": "node --env-file-if-exists=.env scripts/check-storage.ts",
    "format": "prettier --write src scripts test public",
    "format:check": "prettier --check src scripts test public",
    "test:e2e": "playwright test -c test/e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
