# Copy to .env. Never commit credentials.
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Generate with: npm run password (supply password on stdin)
OWNER_PASSWORD_HASH=
# Keep the bucket private. R2, AWS S3, and other S3-compatible services are supported.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set only after agreeing to the descriptor model's terms in Cloudflare.
DESCRIPTOR_TERMS_ACCEPTED=false
# Independent model/version names; questions snapshot these on upload.
DESCRIPTOR_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
GENERATOR_MODEL=@cf/black-forest-labs/flux-1-schnell
# Free-tier caps (see README "Staying at $0"). Defaults are 80% of each free allowance;
# values above that are rejected at startup. Lower them freely.
DAILY_NEURON_BUDGET=8000
R2_CLASS_A_MONTHLY_CAP=800000
R2_CLASS_B_MONTHLY_CAP=8000000
R2_STORED_BYTES_CAP=8000000000
# Day of month (1-28) your Cloudflare billing period starts; R2 op counters reset then.
R2_BILLING_DAY=1
MAX_LIVE_GAMES=50
MAX_LIVE_QUESTIONS=500
# In-memory LRU cache in front of R2 reads (bytes).
IMAGE_CACHE_MAX_BYTES=67108864
# Conservative per-call reservations. Revalidate when changing models or parameters.
DESCRIPTOR_NEURON_RESERVATION=200
GENERATOR_NEURON_RESERVATION=80
# Optional: read-only token with "Account Analytics: Read" to reconcile account-wide neuron usage.
CLOUDFLARE_ANALYTICS_TOKEN=
# Optional: trusted client-IP header when behind a proxy/tunnel, e.g. cf-connecting-ip.
# Leave empty when the app is exposed directly (the header could be spoofed).
CLIENT_IP_HEADER=
