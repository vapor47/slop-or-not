# Production env for the Oracle VM: install as /etc/slop-or-not/app.env
# (owner root, group slop, mode 0640). Never commit real values.
# Values must be unquoted: both systemd and node --env-file read this file.
# The systemd unit forces NODE_ENV=production and DATA_DIR=/data.
APP_ORIGIN=https://slop.example.com
PORT=3000
# Loopback only: cloudflared (or Caddy) is the only thing that talks to the app.
HOST=127.0.0.1
# Generate with: npm run password (supply password on stdin)
OWNER_PASSWORD_HASH=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DESCRIPTOR_TERMS_ACCEPTED=false
DESCRIPTOR_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
GENERATOR_MODEL=@cf/black-forest-labs/flux-1-schnell
DAILY_NEURON_BUDGET=9000
DESCRIPTOR_NEURON_RESERVATION=200
GENERATOR_NEURON_RESERVATION=60

# --- Operations (read by deploy/*.sh only; the app ignores them) ---
# Backups go to the same bucket under this prefix (outside the slop/ lifecycle rule).
BACKUP_PREFIX=backups/
BACKUP_KEEP=14
# Optional: separate R2 credentials for backups (fall back to S3_* when empty).
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional dead-man's-switch URLs (e.g. https://hc-ping.com/<uuid>).
BACKUP_HEALTHCHECK_URL=
LOGWATCH_HEALTHCHECK_URL=
LOGWATCH_THRESHOLD=5
