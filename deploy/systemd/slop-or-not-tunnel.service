# Cloudflare Tunnel for Slop or Not: outbound-only, so no inbound ports are opened.
# The tunnel token lives in /etc/slop-or-not/tunnel.env (root, 0600) as TUNNEL_TOKEN=...
# rather than on the command line, so it does not appear in `ps` or `systemctl cat`.
[Unit]
Description=Cloudflare Tunnel for Slop or Not
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/slop-or-not/tunnel.env
# Updates come from the package repository (unattended-upgrades / dnf-automatic).
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
